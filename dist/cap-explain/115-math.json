  "115-math-1": {
    "answer": "C",
    "keyIdea": "兩式相加消去 y，求出 x 後代回檢查。",
    "steps": [
      "由 x＋2y＝5、2x−2y＝1，將左右兩邊分別相加，得到 3x＝6。",
      "所以 x＝2。代回第一式得 y＝1.5；第二式 2×2−2×1.5＝1 也成立，故選 C。"
    ],
    "options": {
      "A": "x＝−4 會使兩式相加後的 3x＝−12，並非 6。",
      "B": "x＝−2 時 3x＝−6，不符合相加結果。",
      "C": "x＝2 使 3x＝6，且可代回兩式驗證。",
      "D": "x＝4 時 3x＝12，不符合相加結果。"
    },
    "trap": "消去 y 後要把 6 除以 x 的係數 3。",
